{
  "name": "hoshi-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Лендинг приложения hoshi — аниме-плеер для iOS и Android",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "node tools/serve.mjs",
    "typecheck": "tsc --noEmit",
    "capture": "node tools/capture-app.mjs",
    "screens": "python tools/prepare-screens.py",
    "favicon": "python tools/make-favicon.py",
    "posters": "python tools/fetch-posters.py",
    "shoot": "node tools/shoot-landing.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
